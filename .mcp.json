{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "playwright": {
      "command": "bash",
      "args": ["scripts/playwright-mcp.sh"]
    },
    "graphify": {
      "command": "bash",
      "args": ["scripts/graphify-mcp.sh"],
      "env": {
        "GRAPHIFY_GRAPH": "${GRAPHIFY_GRAPH:-graphify-out/graph.json}"
      }
    }
  }
}
